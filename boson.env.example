# Boson Infinity Node Configuration
# Copy this file to boson.env and fill in your values.
# Environment variables take priority over this file.

# ---- REQUIRED ----
BOSON_API_KEY=your-64-hex-api-key-here
BOSON_TREASURY_ADDR=your-40-hex-treasury-address

# ---- OPTIONAL ----
# BOSON_BRIDGE_OPERATOR_ADDR=same-as-treasury-by-default
# BOSON_P2P_TOKEN=your-p2p-auth-token
# BOSON_RPC_PORT=8080
# BOSON_P2P_PORT=8081
# BOSON_RPC_BIND=0.0.0.0
# BOSON_P2P_BIND=0.0.0.0
# BOSON_ALLOWED_ORIGINS=*
# BOSON_ALLOWED_IPS=
# BOSON_DATA_DIR=.
# BOSON_CHAIN_FILE=chain.mainnet.json
# BOSON_DEBUG=1
# BOSON_MAX_MEMPOOL=10000
# BOSON_MAX_PENDING_PER_ADDR=10

# ---- P2P / Seed Nodes ----
# BOSON_SEED_NODES=http://seed1.boson.example:8081,http://seed2.boson.example:8081

# ---- Wallet (separate binary) ----
# BOSON_NODE_URL=http://127.0.0.1:8080
# BOSON_WALLET_PASS=your-wallet-encryption-passphrase

# ---- Miner ----
# BOSON_NODE_URL=http://your-node:8080
# BOSON_WALLET=your-40-hex-wallet

# ---- Oracle ----
# BFI_ORACLE_SECRET=your-oracle-hmac-secret
# BFI_ORACLE_BIND=0.0.0.0:8090
