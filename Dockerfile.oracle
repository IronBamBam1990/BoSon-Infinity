FROM golang:1.23-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /boson-oracle ./cmd/oracle/

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
RUN adduser -D -h /data boson
COPY --from=builder /boson-oracle /usr/local/bin/
USER boson
WORKDIR /data
EXPOSE 8090
ENTRYPOINT ["boson-oracle"]
